    "message.potato_s_t.solar.state.dimension":  "此维度没有阳光",
    "block.potato_s_t.micro_crusher":  "微型粉碎机",
    "tooltip.potato_s_t.micro_crusher":  "粉碎配方（有红石信号即关机）：\n· 紫水晶碎片 / 下界石英 -> 1 硅（30s，30 FE/t）\n· 紫水晶块 -> 12~18 硅（120s，80 FE/t）\n· 石英建材（普通/平滑/錾制/柱/楼梯/台阶）-> 2 硅（40s，50 FE/t）\n· 各类原木（含去皮）-> 3~6 个对应木板（5s，1 FE/t）\n· 绿宝石矿石 / 深层绿宝石矿石 -> 15~40 绿宝石（180s，400 FE/t）\n· 钻石矿石 / 深层钻石矿石 -> 3~12 钻石（90s，400 FE/t）\n· 粗锂 -> 2~4 锂矿精粉（12s，20 FE/t）\n· 煤炭 / 木炭 -> 1 碳粉（3s，10 FE/t）\n· 铁锭 -> 1 铁粉（20s，70 FE/t）\n铜锭 -> 4 铜线（3s，90 FE/t）\n内部缓冲 2500 FE\n（矿石、粗锂与石英按 c: 通用标签匹配，别的 mod 的同类物品也认）",
    "gui.potato_s_t.micro_crusher.status.disabled":  "已关闭：有红石信号（有信号即停机）",
    "gui.potato_s_t.micro_crusher.status.empty":  "待机：输入槽是空的",
    "gui.potato_s_t.micro_crusher.status.invalid":  "无法粉碎：这个物品没有配方",
    "gui.potato_s_t.micro_crusher.status.no_power":  "电力不足：需要持续供电",
    "gui.potato_s_t.micro_crusher.status.output_full":  "输出槽已满，等腾出位置",
    "gui.potato_s_t.micro_crusher.status.running":  "正在粉碎",
    "block.potato_s_t.hydraulic_press":  "液压机",
    "item.potato_s_t.copper_plate":  "铜板",
    "tooltip.potato_s_t.hydraulic_press":  "把矿物锭锻压成对应板材。\n耗电 400 FE/t，3 秒产出一块板。\n可加工：铜、铁、镍、钴、银、铝、钢。\n沥青 ×12 → 柏油块（纯建筑方块）。\n红石信号通入时停机，进度保留。\n配方一览见 JEI。",
    "gui.potato_s_t.hydraulic_press.status.disabled":  "已停机（红石信号）",
    "gui.potato_s_t.hydraulic_press.status.empty":  "输入槽为空",
  "gui.potato_s_t.hydraulic_press.status.material":  "材料不够：沥青要 12 个",
    "gui.potato_s_t.hydraulic_press.status.invalid":  "该物品不可锻压",
    "gui.potato_s_t.hydraulic_press.status.no_power":  "电力不足：需要持续供电",
    "gui.potato_s_t.hydraulic_press.status.output_full":  "输出槽已满，等待腾出位置",
    "gui.potato_s_t.hydraulic_press.status.running":  "正在锻压",
    "block.potato_s_t.salt_decomposer":  "盐分解构器",
    "item.potato_s_t.sodium_chloride":  "氯化钠",
    "tooltip.potato_s_t.salt_decomposer":  "分解海盐制取氯化钠。\n每次投入 64 个海盐，40 秒后产出 1 个氯化钠。\n60% 概率返还 64 个海盐；5% 概率额外产出一个随机粗矿。\n耗电 20 FE/t，自身储能仅 20 FE，需持续供电。\n红石信号通入时停机，进度保留。",
    "gui.potato_s_t.jei.salt_return":  "%s%% 概率返还 %s 个海盐",
    "gui.potato_s_t.jei.raw_ore_chance":  "%s%% 概率额外产出一个随机粗矿",
    "gui.potato_s_t.salt_decomposer.status.running":  "正在分解",
    "gui.potato_s_t.salt_decomposer.status.empty":  "输入槽为空",

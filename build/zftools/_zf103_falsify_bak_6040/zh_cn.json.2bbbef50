    "item.potato_s_t.photovoltaic_component":  "光伏原件",
    "gui.potato_s_t.jei.energy_per_item":  "每件耗电 %s FE",
    "gui.potato_s_t.jei.ebf_vanilla":  "支持原版高炉烧制配方",

  "gui.potato_s_t.distillation.towers":  "Towers: %s / %s",
  "gui.potato_s_t.distillation.status.running":  "Distilling",
  "gui.potato_s_t.distillation.status.no_controller":  "No controller adjacent",
  "gui.potato_s_t.distillation.status.no_tower":  "No distillation tower found",
  "gui.potato_s_t.distillation.status.no_redstone":  "No redstone signal",
  "gui.potato_s_t.distillation.status.bitumen_full":  "Bitumen slot full (64)",
  "gui.potato_s_t.distillation.status.no_oil":  "Not enough oil",
  "gui.potato_s_t.distillation.status.no_power":  "Not enough power",
  "gui.potato_s_t.distillation.status.product_full":  "Product tanks full",
  "tooltip.potato_s_t.distillation_controller":  "Structure 4x4x7 (7 layers):\n- Layers 1-2: Common Metal Block on the four corners\n- Layers 3 / 5: corners = Common Metal Block, edges = Heat-Resistant Metal Block, centre 2x2 = Heater\n- Layers 4 / 6: a ring of Heat-Resistant Metal Block (hollow)\n- Layer 7: 4x4 of Common Metal Block\n- Every cell drawn as empty must be air\nScans 32x32x10 around itself and reports the tower count to an adjacent Operator",
  "tooltip.potato_s_t.distillation_operator":  "Per tower, per tick: 8 mB crude oil + 8096 FE -> 3 diesel + 2 naphtha + 2 gasoline + 1 LPG\nEvery 5 ticks: 1 bitumen per tower; a full stack of 64 and no room left stops it\nCapacity per tower: 8096 FE, 12 buckets of oil, 2.5 buckets per product\nNeeds a redstone signal; recognises up to 4 towers",
  "gui.potato_s_t.distillation.diagnosis.found":  "Detected %s distillation tower(s) - up to 4 are recognised",
  "gui.potato_s_t.distillation.diagnosis.none":  "No tower found: the closest candidate has %s of 112 cells wrong - layer %s, row %s, column %s (at %s) should be '%s' but is '%s'",
  "gui.potato_s_t.distillation.diagnosis.empty":  "Nothing within 32x32x10 looks like a distillation tower (start with the four corners of layer 1)",
  "gui.potato_s_t.distillation.pour.rejected":  "Cannot pour %s in (crude oil only; full tank / wrong fluid / no tower detected yet (capacity 0))",
  "gui.potato_s_t.distillation.pour.empty":  "That container is empty",
  "tooltip.potato_s_t.oil_bucket.total":  "Liquid: %s / %s mB",

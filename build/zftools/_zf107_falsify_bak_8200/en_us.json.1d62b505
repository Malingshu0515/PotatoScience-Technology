    "item.potato_s_t.capacitor":  "Capacitor",
    "block.potato_s_t.solar_panel":  "Solar Panel",
    "tooltip.potato_s_t.solar_panel":  "Generates power in daytime only: 60 FE/t at dawn and dusk, 135 in the morning and afternoon, 180 at noon.\nOutput drops to 60% in rain and 20% in thunderstorms.\nThe block directly above must be air or colorless glass.\nStores 512 FE and feeds the block below automatically.\nHorizontally adjacent panels connect automatically, sharing generation and storage across the group.",
    "message.potato_s_t.solar_status":  "Solar panels: %s connected, total %s FE/t",
    "message.potato_s_t.solar_self":  "This panel gets %s FE/t, status: %s",
    "message.potato_s_t.solar_pool":  "Shared storage %s / %s FE (this panel holds %s / %s FE)",
    "message.potato_s_t.solar.state.clear":  "clear",
    "message.potato_s_t.solar.state.rain":  "rain (60%)",
    "message.potato_s_t.solar.state.thunder":  "thunder (20%)",
    "message.potato_s_t.solar.state.night":  "night (no output)",
    "message.potato_s_t.solar.state.blocked":  "blocked above",
    "message.potato_s_t.solar.state.dimension":  "no sunlight in this dimension",
    "block.potato_s_t.micro_crusher":  "Micro Crusher",
    "tooltip.potato_s_t.micro_crusher":  "Crushing recipes (a redstone signal turns it OFF):\n· Amethyst Shard / Nether Quartz -> 1 Silicon (30s, 30 FE/t)\n· Block of Amethyst -> 12~18 Silicon (120s, 80 FE/t)\n· Quartz building blocks (block/smooth/chiseled/pillar/stairs/slab) -> 2 Silicon (40s, 50 FE/t)\n· Any log or wood, stripped included -> 3~6 matching planks (5s, 1 FE/t)\n· Emerald Ore / Deepslate Emerald Ore -> 15~40 Emeralds (180s, 400 FE/t)\n· Diamond Ore / Deepslate Diamond Ore -> 3~12 Diamonds (90s, 400 FE/t)\n· Raw Lithium -> 2~4 Lithium Concentrate (12s, 20 FE/t)\n· Coal / Charcoal -> 1 Carbon Dust (3s, 10 FE/t)\n· Iron Ingot -> 1 Iron Dust (20s, 70 FE/t)\nCopper Ingot -> 4 Copper Wire (3s, 90 FE/t)\nInternal buffer: 2500 FE\n(Ores, raw lithium and quartz match by c: common tags, so other mods' equivalents work too)",
    "gui.potato_s_t.micro_crusher.status.disabled":  "Disabled: redstone signal present",
    "gui.potato_s_t.micro_crusher.status.empty":  "Idle: input slot is empty",
    "gui.potato_s_t.micro_crusher.status.invalid":  "Cannot crush: no recipe for this item",
    "gui.potato_s_t.micro_crusher.status.no_power":  "Not enough energy",
    "gui.potato_s_t.micro_crusher.status.output_full":  "Output slots are full",
    "gui.potato_s_t.micro_crusher.status.running":  "Crushing",
    "block.potato_s_t.hydraulic_press":  "Hydraulic Press",
    "item.potato_s_t.copper_plate":  "Copper Plate",
    "tooltip.potato_s_t.hydraulic_press":  "Presses mineral ingots into the corresponding plates.\nConsumes 400 FE/t and produces one plate every 3 seconds.\nAccepts copper, iron, nickel, cobalt, silver, aluminium and steel.\n12 bitumen -> 1 asphalt block (decorative).\nA redstone signal halts operation; progress is kept.\nSee JEI for the recipe list.",
    "gui.potato_s_t.hydraulic_press.status.disabled":  "Halted by redstone signal",
    "gui.potato_s_t.hydraulic_press.status.empty":  "Input slot is empty",
  "gui.potato_s_t.hydraulic_press.status.material":  "Not enough material: 12 bitumen needed",
    "gui.potato_s_t.hydraulic_press.status.invalid":  "This item cannot be pressed",
    "gui.potato_s_t.hydraulic_press.status.no_power":  "Not enough power: continuous supply needed",
    "gui.potato_s_t.hydraulic_press.status.output_full":  "Output slot is full, waiting for space",
    "gui.potato_s_t.hydraulic_press.status.running":  "Pressing",
    "block.potato_s_t.salt_decomposer":  "Salt Decomposer",
    "item.potato_s_t.sodium_chloride":  "Sodium Chloride",
    "tooltip.potato_s_t.salt_decomposer":  "Decomposes sea salt into sodium chloride.\nConsumes 64 sea salt and yields 1 sodium chloride every 40 seconds.\nA 60% chance returns 64 sea salt; a 5% chance yields one random raw ore.\nConsumes 20 FE/t and stores only 20 FE, so it needs a continuous supply.\nA redstone signal halts operation; progress is kept.",
    "gui.potato_s_t.jei.salt_return":  "%s%% chance to return %s sea salt",
    "gui.potato_s_t.jei.raw_ore_chance":  "%s%% chance for one random raw ore",
    "gui.potato_s_t.salt_decomposer.status.running":  "Decomposing",
    "gui.potato_s_t.salt_decomposer.status.empty":  "Input slot is empty",
    "gui.potato_s_t.salt_decomposer.status.invalid":  "Requires 64 sea salt",
    "gui.potato_s_t.salt_decomposer.status.no_power":  "Not enough power: continuous supply needed",
    "gui.potato_s_t.salt_decomposer.status.output_full":  "Output slots are full, waiting for space",
    "gui.potato_s_t.salt_decomposer.status.disabled":  "Halted by redstone signal",
    "block.potato_s_t.common_metal_block":  "Common Metal Block",
    "block.potato_s_t.advanced_metal_block":  "Advanced Metal Block",
    "block.potato_s_t.stable_metal_block":  "Stable Metal Block",
    "block.potato_s_t.heat_resistant_metal_block":  "Heat-Resistant Metal Block",
    "block.potato_s_t.heater":  "Heater",
    "block.potato_s_t.heat_sink":  "Heat Sink",
    "block.potato_s_t.wiring_block":  "Wiring Block",
    "block.potato_s_t.low_generator":  "Low-Tier Generator",
    "tooltip.potato_s_t.low_generator":  "Burns coal or charcoal to generate power.\nEach fuel item burns for 45 seconds at 100 FE/t.\nInternal storage is 1000 FE; burning pauses when full.\nA redstone signal halts operation.",
    "block.potato_s_t.electric_blast_furnace":  "Electric Blast Furnace",
    "tooltip.potato_s_t.electric_blast_furnace":  "Assembled from a 3x3x3 structure.\nBuild the shell, then shift-right-click with an empty hand to form it - the anchor may be either a vanilla blast furnace or this mod's own controller block.\nHold a wrench and shift-right-click to take it apart.\n12 input slots and 32 output slots; each slot finishes in 10 seconds.\nEach item costs 800 FE, it stores 4096 FE, and a full load draws about 3072 FE/t.\nIron Dust + Carbon Dust -> High Carbon Steel; Iron Dust + Gravel -> Magnet (any two input slots pair up automatically).\nIt also handles everything a blast furnace can smelt.",
    "gui.potato_s_t.ebf.invalid":  "Structure invalid: layer %s, row %s, column %s should be %s",
    "gui.potato_s_t.ebf.formed":  "Electric Blast Furnace formed",
    "item.potato_s_t.wrench":  "Wrench",
    "block.potato_s_t.electric_blast_furnace_part":  "Electric Blast Furnace",
    "item.potato_s_t.iron_powder":  "Iron Dust",
    "item.potato_s_t.magnet":  "Magnet",
    "item.potato_s_t.thermal_metal":  "Thermal Metal",
    "item.potato_s_t.photovoltaic_component":  "Photovoltaic Component",
    "gui.potato_s_t.jei.energy_per_item":  "Costs %s FE per item",
    "gui.potato_s_t.jei.ebf_vanilla":  "Also smelts everything a blast furnace can",
    "block.potato_s_t.wolframite_ore":  "Wolframite Ore",
    "block.potato_s_t.deepslate_wolframite_ore":  "Deepslate Wolframite Ore",
    "item.potato_s_t.raw_tungsten":  "Raw Tungsten",
    "block.potato_s_t.titanium_ore":  "Titanium Ore",
    "block.potato_s_t.deepslate_titanium_ore":  "Deepslate Titanium Ore",
    "item.potato_s_t.raw_titanium":  "Raw Titanium",
    "item.potato_s_t.titanium_powder":  "Titanium Dust",
    "item.potato_s_t.titanium_ingot":  "Titanium Ingot",
    "item.potato_s_t.light_titanium_alloy":  "Lightweight Titanium Alloy",
    "item.potato_s_t.titanium_alloy_sword":  "Titanium Alloy Sword",
    "item.potato_s_t.titanium_alloy_pickaxe":  "Titanium Alloy Pickaxe",
    "block.potato_s_t.alloy_smelter":  "Alloy Smelter Controller",
    "block.potato_s_t.alloy_smelter_port":  "Alloy Smelter Power Port",
    "block.potato_s_t.alloy_smelter_part":  "Alloy Smelter",
    "tooltip.potato_s_t.alloy_smelter":  "Alloy Smelter layout (the controller is the cell marked 7: layer 2, front row, right column)\n1 Heat-Resistant Metal Block  2 Common Metal Block  3 Heater  4 Blast Furnace\n5 Wiring Block  6 Heat Sink  7 Alloy Smelter Controller  0 empty\nLayer 1 (bottom)|Layer 2\n2222|5115\n2332|4004\n2332|4004\n2332|4004\n2222|6117\nLayer 3|Layer 4 (top)\n1111|0110\n1001|0110\n1001|0110\n1001|0110\n1111|0110\nThe machine activates on its own once the whole 4-layer drawing is built (58 cells are checked: floor + three lower wall layers + the two heat-resistant columns on the roof) and at least one wiring block is in the shell (the inside is free, the rest of the roof does not matter); right-clicking the controller also activates it (it names the missing cell); only then does right-click open the GUI. 5 inputs (ingots only) / 3 outputs / 2 consumable slots, 32768 FE, power enters through the ports only.",
    "gui.potato_s_t.alloy_smelter.invalid":  "Shell gap: layer %s, row %s, column %s is %s (at %s %s %s) - a machine block belongs here",
    "gui.potato_s_t.alloy_smelter.no_port":  "There is no wiring block in the shell, so the machine cannot take power: put at least one wiring block in the shell",
    "gui.potato_s_t.alloy_smelter.formed":  "Alloy Smelter activated",
    "gui.potato_s_t.alloy_smelter.consume_slot":  "Consumable slot (not yet usable)",
    "gui.potato_s_t.alloy_smelter.input_hint":  "Input slots accept ingots only",
    "gui.potato_s_t.alloy_smelter.name":  "Alloy Smelter",
    "gui.potato_s_t.alloy_smelter.status":  "Alloy Smelter active: %s / %s FE",
    "advancements.potato_s_t.new_beginning.title":  "A New Beginning!",
    "advancements.potato_s_t.new_beginning.description":  "Build a Micro Crusher - it grinds ore into dust, and everything else is built on that",
    "advancements.potato_s_t.stronger_power.title":  "A Stronger Power Source",
    "advancements.potato_s_t.stronger_power.description":  "Electricity makes magnetism, magnetism makes electricity... don't ask me why wires can carry power",
    "advancements.potato_s_t.clean_energy.title":  "Clean Energy 101",
    "advancements.potato_s_t.clean_energy.description":  "Quantitative change brings qualitative change",
    "block.potato_s_t.hydrodesulfurization_chamber":  "Hydrodesulfurization Chamber",
    "item.potato_s_t.sulfur":  "Sulfur",
    "tooltip.potato_s_t.hydrodesulfurization_chamber":  "Per batch: 16 Bitumen + 1000 mB hydrogen -> 10 s -> 1 Sulfur\nHydrogen tank holds 4000 mB: feed it with pipes/pumps, or right-click the machine with a gas tank full of hydrogen to pour\nThe left slot takes bitumen only; a redstone signal stops it (progress is kept)\nThis machine uses no energy",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.running":  "Reacting",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.disabled":  "Stopped (redstone signal)",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.empty":  "Bitumen slot is empty",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.material":  "Not enough bitumen: 16 per batch",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.output_full":  "Output slot is full, waiting for room",
    "gui.potato_s_t.hydrodesulfurization_chamber.status.no_hydrogen":  "Not enough hydrogen: 1000 mB per batch (right-click the machine with a tank of hydrogen to pour)",
    "gui.potato_s_t.hydrodesulfurization_chamber.pour.empty":  "That container is empty",
    "gui.potato_s_t.hydrodesulfurization_chamber.pour.rejected":  "Cannot pour %s in (hydrogen only; tank full / wrong fluid)",
    "gui.potato_s_t.jei.no_energy":  "No energy needed",
    "fluid_type.potato_s_t.nitrogen":  "Nitrogen",
    "fluid_type.potato_s_t.ammonia":  "Ammonia",
    "block.potato_s_t.air_separator":  "Air Separator",
    "block.potato_s_t.ammonia_synthesis_chamber":  "Ammonia Synthesis Chamber",
    "tooltip.potato_s_t.air_separator":  "Per 30 s: 8 mB nitrogen + 2 mB oxygen (the raw material is air)\n200 FE/t, 5,000 FE buffer\nThe two tanks are output-only: pumps can drain them, but nothing can be poured or piped in\nA redstone signal stops it (progress is kept)",
    "tooltip.potato_s_t.ammonia_synthesis_chamber":  "Per tick: 1 mB nitrogen + 1 mB hydrogen + 200 FE -> 1 mB ammonia\nThe catalyst slot needs iron dust (it is NOT consumed); the gas-tank slot under each input tank moves 50 mB/t from the tank item into the machine\nThe gas-tank slot under the output tank works the other way: 50 mB/t of ammonia into the tank item\nPipes can only push nitrogen/hydrogen in and pull ammonia out; a redstone signal stops it",
    "gui.potato_s_t.air_separator.status.running":  "Separating air",
    "gui.potato_s_t.air_separator.status.disabled":  "Stopped (redstone signal)",
    "gui.potato_s_t.air_separator.status.no_power":  "Not enough power: 200 FE per tick",
    "gui.potato_s_t.air_separator.status.output_full":  "A tank is full (no room for the next batch) - pump it out",
    "gui.potato_s_t.ammonia_synthesis.status.running":  "Synthesising ammonia",
    "gui.potato_s_t.ammonia_synthesis.status.disabled":  "Stopped (redstone signal)",
    "gui.potato_s_t.ammonia_synthesis.status.no_power":  "Not enough power: 200 FE per tick",
    "gui.potato_s_t.ammonia_synthesis.status.output_full":  "The ammonia tank is full - pump it out or swap the gas tank",
    "gui.potato_s_t.ammonia_synthesis.status.no_hydrogen":  "Not enough hydrogen (input tank empty: use pipes or the gas-tank slot)",
    "gui.potato_s_t.ammonia_synthesis.status.no_nitrogen":  "Not enough nitrogen (input tank empty: use pipes or the gas-tank slot)",
    "gui.potato_s_t.ammonia_synthesis.status.no_catalyst":  "Put iron dust in the catalyst slot (it is not consumed)",
    "gui.potato_s_t.ammonia_synthesis.catalyst":  "Catalyst (Iron Dust)",
    "gui.potato_s_t.jei.catalyst":  "Needs iron dust as the catalyst (it is not consumed)",
    "block.potato_s_t.combustion_chamber":  "Combustion Reaction Chamber",
    "tooltip.potato_s_t.combustion_chamber":  "Fuel slot takes anything a vanilla furnace burns (lava bucket 10 s, diesel/gasoline bucket 30 s, everything else 3 s)\nOne fuel item + 10 mB oxygen starts a reaction; while it runs it feeds 800 Power/tick to an adjacent Power Capturer\n(diesel 1200, gasoline 1000), so put it next to one\nLogs -> 10 mB carbon dioxide + 1 charcoal; diesel/gasoline bucket -> 200 mB carbon dioxide + 50 mB water; anything else -> 5 mB carbon dioxide\nThe oxygen tank only takes oxygen in, the carbon dioxide and water tanks only let fluid out; a redstone signal stops it",
    "gui.potato_s_t.combustion_chamber.status.running":  "Burning",
    "gui.potato_s_t.combustion_chamber.status.disabled":  "Switched off (redstone signal)",
    "gui.potato_s_t.combustion_chamber.status.empty":  "The fuel slot is empty",
    "gui.potato_s_t.combustion_chamber.status.invalid":  "This item is not a fuel (a vanilla furnace must accept it)",
    "gui.potato_s_t.combustion_chamber.status.output_full":  "The carbon dioxide or water tank is full - pump it out",
    "gui.potato_s_t.combustion_chamber.status.no_oxygen":  "Not enough oxygen: one reaction needs 10 mB",
    "gui.potato_s_t.combustion_chamber.status.byproduct":  "The byproduct slot is full (make room for charcoal / an empty bucket)",
    "gui.potato_s_t.combustion_chamber.pour.empty":  "The held container is empty",
    "gui.potato_s_t.combustion_chamber.pour.rejected":  "Cannot pour: the oxygen tank only takes oxygen (holding %s)",
    "fluid_type.potato_s_t.carbon_dioxide":  "Carbon Dioxide",
    "block.potato_s_t.acidic_reaction_chamber":  "Acidic Reaction Chamber",
    "tooltip.potato_s_t.acidic_reaction_chamber":  "Four input tanks (1,000 mB each): carbon dioxide / oxygen / ammonia / water; three output tanks: carbonic / nitric / sulfuric acid\nPick a recipe with the three buttons: (1) 10 mB carbon dioxide + 1 mB water -> 1 mB carbonic acid, (2) 1 mB oxygen + 1 mB ammonia -> 1 mB nitric acid\n(3) 10 sulfur + 100 mB water -> 100 mB sulfuric acid (one batch every 5 seconds; the materials are only taken on the last tick)\nAll three draw 500 FE/t with a 12,400 FE buffer, so it needs a steady supply; a redstone signal stops it",
    "gui.potato_s_t.acidic_reaction_chamber.status.running":  "Reacting",
    "gui.potato_s_t.acidic_reaction_chamber.status.disabled":  "Switched off (redstone signal)",
    "gui.potato_s_t.acidic_reaction_chamber.status.no_power":  "Not enough power: 500 FE per tick",
    "gui.potato_s_t.acidic_reaction_chamber.status.output_full":  "An output tank is full - pump it out",
    "gui.potato_s_t.acidic_reaction_chamber.status.material":  "Not enough sulfur for one batch (10 needed)",
    "gui.potato_s_t.acidic_reaction_chamber.status.inputs":  "Not enough fluid input (fill the tanks this recipe needs)",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.name.0":  "Carbonic",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.name.1":  "Nitric",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.name.2":  "Sulfuric",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.info.0":  "Carbonic acid: 10 mB carbon dioxide + 1 mB water -> 1 mB per tick",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.info.1":  "Nitric acid: 1 mB oxygen + 1 mB ammonia -> 1 mB per tick",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.info.2":  "Sulfuric acid: 10 sulfur + 100 mB water -> 100 mB per 5 s batch",
    "fluid_type.potato_s_t.carbonic_acid":  "Carbonic Acid",
    "fluid_type.potato_s_t.nitric_acid":  "Nitric Acid",
    "fluid_type.potato_s_t.sulfuric_acid":  "Sulfuric Acid",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.name.3":  "Hydrochloric",
    "gui.potato_s_t.acidic_reaction_chamber.recipe.info.3":  "Hydrochloric acid: 10 mB hydrogen + 10 mB chlorine + 5 mB water -> 5 mB per tick",
    "fluid_type.potato_s_t.hydrochloric_acid":  "Hydrochloric Acid",
  "item.potato_s_t.star_steel_ingot":  "Star Steel Ingot",
  "item.potato_s_t.titanium_alloy_helmet":  "Titanium Alloy Helmet",
  "item.potato_s_t.titanium_alloy_chestplate":  "Titanium Alloy Chestplate",
  "item.potato_s_t.titanium_alloy_leggings":  "Titanium Alloy Leggings",
  "item.potato_s_t.titanium_alloy_boots":  "Titanium Alloy Boots",
  "item.potato_s_t.star_steel_helmet":  "Star Steel Helmet",
  "item.potato_s_t.star_steel_chestplate":  "Star Steel Chestplate",
  "item.potato_s_t.star_steel_leggings":  "Star Steel Leggings",
  "item.potato_s_t.star_steel_boots":  "Star Steel Boots",
  "tooltip.potato_s_t.titanium_alloy_set":  "Titanium Alloy set: enchantment value 25 (gold is 22). Helmet 2801 durability / +2.5 armor; chestplate 4096 / +8; leggings 3412 / +6; boots 2048 / +4.5. Repair material: Light Titanium Alloy",
  "tooltip.potato_s_t.star_steel_set":  "Star Steel set: every piece grants Resistance I at night (four pieces still only I) and no durability loss at night; with all four pieces worn, durability is never consumed in the End. Full set: in the Overworld at night, Strength I and Resistance II, plus 10 s of Absorption III every 45 s; in the End, Regeneration I, Resistance III and Strength II, plus 12 s of Absorption VI every 15 s. Absorption is a periodic one-shot shield: the next one is granted only after the current one runs out (or is used up) - it is never topped up early. When you take void damage you are teleported to the nearest block within 20x20 (any height) - Slow Falling is applied and fall distance cleared first, so you will not die from the drop - or swapped with a nearby mob if there is no block. Repair material: Star Steel Ingot",
  "message.potato_s_t.star_steel_void_block":  "Star Steel set: teleported to the nearest block",
  "message.potato_s_t.star_steel_void_swap":  "Star Steel set: no block nearby, swapped with a mob",
  "message.potato_s_t.star_steel_void_failed":  "Star Steel set: no block and no mob to swap with",
    "item.potato_s_t.hard_titanium_alloy":  "Hard Titanium Alloy",
    "advancements.potato_s_t.acid.description":  "Carbonic, nitric, sulfuric and hydrochloric acid — all four are made here",
    "advancements.potato_s_t.acid.title":  "Acidic Reaction Chamber",
    "advancements.potato_s_t.alloy_smelter.description":  "Controller + power port + casings: three kinds of plate + Capacitor + Heater + Heat Sink — the start of the alloy line",
    "advancements.potato_s_t.alloy_smelter.title":  "Alloy Smelter",
    "advancements.potato_s_t.ammonia.description":  "The Air Separator gives nitrogen; nitrogen + hydrogen make Ammonia in the Ammonia Synthesis Chamber (raw material for nitric acid)",
    "advancements.potato_s_t.ammonia.title":  "Ammonia",
    "advancements.potato_s_t.blast_furnace.description":  "A 3×3×3 multiblock: put a vanilla Blast Furnace or the controller as the front anchor, then wall it in with casings — right-click the controller to check the build",
    "advancements.potato_s_t.blast_furnace.title":  "Electric Blast Furnace",
    "advancements.potato_s_t.capacitor.description":  "Copper Ingot + Aluminum Plate + Silver Plate = Capacitor; the Electric Blast Furnace, Alloy Smelter and Solar Panel all need one",
    "advancements.potato_s_t.capacitor.title":  "Capacitor",
    "advancements.potato_s_t.combustion.description":  "One fuel + 10 mB Oxygen → Carbon Dioxide; feed it a log and you also get charcoal",
    "advancements.potato_s_t.combustion.title":  "Combustion Chamber",
    "advancements.potato_s_t.crushing.description":  "The crusher turns ingots and ore into dust: Iron Dust + Carbon Dust is what steel is made of (Carbon Dust comes from coal or charcoal)",
    "advancements.potato_s_t.crushing.title":  "Grind It Down",
    "advancements.potato_s_t.distillation.description":  "Controller + operator: split crude oil into diesel, gasoline, naphtha, LPG and bitumen",
    "advancements.potato_s_t.distillation.title":  "Distillation Tower",
    "advancements.potato_s_t.electrolyzer.description":  "Electrolyzer: water + power → Oxygen + Hydrogen; with Sea Salt → Chlorine + Hydrogen",
    "advancements.potato_s_t.electrolyzer.title":  "Electrolysis",
    "advancements.potato_s_t.first_power.description":  "A simple power source - handy and sufficient. Burn coal or charcoal, then run the power to your machines with terminals",
    "advancements.potato_s_t.first_power.title":  "First Watt",
    "advancements.potato_s_t.fuel.description":  "Two liquid fuels, both for the Combustion Chamber (diesel 1200 power, gasoline 1000)",
    "advancements.potato_s_t.fuel.title":  "Diesel & Gasoline",
    "advancements.potato_s_t.gas_handling.description":  "The High-Pressure Gas Tank takes only gases and the Oil Bucket only liquids; the Filling Machine fills both",
    "advancements.potato_s_t.gas_handling.title":  "Storing Gas",
    "advancements.potato_s_t.hard_alloy.description":  "Lightweight Titanium Alloy + High Carbon Steel + Nickel Ingot → Hard Titanium Alloy",
    "advancements.potato_s_t.hard_alloy.title":  "Hard Titanium Alloy",
    "advancements.potato_s_t.light_alloy.description":  "Aluminum Ingot + Titanium Ingot + Silver Ingot → Lightweight Titanium Alloy (alloy smelter, 30 s per batch)",
    "advancements.potato_s_t.light_alloy.title":  "Lightweight Titanium Alloy",
    "advancements.potato_s_t.music_disc_anvil.description":  "Redstone + Titanium Ingot + Anvil = a music disc. That's it. No deeper meaning",
    "advancements.potato_s_t.music_disc_anvil.title":  "The Anvil and the Republic",
    "advancements.potato_s_t.music_disc_jasmine.description":  "Soul Lantern + Raw Gold Block + Torchflower = another music disc. What a beautiful jasmine flower",
    "advancements.potato_s_t.music_disc_jasmine.title":  "Jasmine Flower",
    "advancements.potato_s_t.oil.description":  "Take an Oil Bucket to a surface or ocean oilfield and scoop up some crude oil (an empty bucket does not count)",
    "advancements.potato_s_t.oil.title":  "Oil",
    "advancements.potato_s_t.pressing.description":  "The hydraulic press flattens ingots into plates — iron, copper and aluminum plates are the universal parts of every machine",
    "advancements.potato_s_t.pressing.title":  "Flat as a Plate",
    "advancements.potato_s_t.stable_block.description":  "High Carbon Steel / Hard Titanium Alloy / Gold Block in a 3×3 → Stable Metal Block (the acidic chamber needs it)",
    "advancements.potato_s_t.stable_block.title":  "Stable Metal Block",
    "advancements.potato_s_t.steel.description":  "Iron Dust + Carbon Dust into the Electric Blast Furnace → High Carbon Steel; steel is the backbone of nearly everything after this",
    "advancements.potato_s_t.steel.title":  "Thus Steel Was Made",
    "advancements.potato_s_t.sulfur.description":  "Bitumen + Hydrogen into the Hydrodesulfurization Chamber → Sulfur (the raw material for sulfuric acid)",
    "advancements.potato_s_t.sulfur.title":  "Sulfur",
    "advancements.potato_s_t.titanium.description":  "Crush Raw Titanium into Titanium Dust, then run the dust through the Electric Blast Furnace → Titanium Ingot",
    "advancements.potato_s_t.titanium.title":  "Titanium",
    "advancements.potato_s_t.titanium_tools.description":  "Lightweight Titanium Alloy + Stick → Titanium Alloy Sword and Pickaxe",
    "advancements.potato_s_t.titanium_tools.title":  "Titanium Tools",
    "advancements.potato_s_t.wiring.description":  "Terminal Blocks are the wires: right-click two of them with a Copper Wire Spool to link them (Power Cable Spool for the power network); sneak-right-click to switch input / output",
    "advancements.potato_s_t.wiring.title":  "Wire It Up"
}
  "tooltip.potato_s_t.low_generator": "Burns coal or charcoal to make power.\nA redstone signal halts it.",
  "block.potato_s_t.electric_blast_furnace": "Electric Blast Furnace",
  "tooltip.potato_s_t.electric_blast_furnace": "Assembled from a 3x3x3 structure.\n12 input slots and 32 output slots; each slot finishes in 10 seconds, at 800 FE per item.\nOn top of this mod's ore processing, anything a vanilla blast furnace can smelt works here too.",
  "gui.potato_s_t.ebf.invalid": "Structure invalid: layer %s, row %s, column %s should be %s",
  "gui.potato_s_t.ebf.formed": "Electric Blast Furnace formed",
  "item.potato_s_t.wrench": "Wrench (currently useless)",
  "block.potato_s_t.electric_blast_furnace_part": "Electric Blast Furnace",
  "item.potato_s_t.iron_powder": "Iron Dust",
  "item.potato_s_t.magnet": "Magnet",
  "item.potato_s_t.thermal_metal": "Thermal Metal",
  "item.potato_s_t.photovoltaic_component": "Photovoltaic Component",
  "gui.potato_s_t.jei.energy_per_item": "%s FE per item",
  "gui.potato_s_t.jei.ebf_vanilla": "Supports vanilla blast furnace recipes",
  "block.potato_s_t.wolframite_ore": "Wolframite Ore",
  "block.potato_s_t.deepslate_wolframite_ore": "Deepslate Wolframite Ore",

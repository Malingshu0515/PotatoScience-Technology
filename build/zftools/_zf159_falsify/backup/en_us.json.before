  "block.potato_s_t.titanium_ore": "Titanium Ore",
  "block.potato_s_t.deepslate_titanium_ore": "Deepslate Titanium Ore",
  "item.potato_s_t.raw_titanium": "Raw Titanium",
  "item.potato_s_t.titanium_powder": "Titanium Dust",
  "item.potato_s_t.titanium_ingot": "Titanium Ingot",
  "item.potato_s_t.light_titanium_alloy": "Light Titanium Alloy",
  "item.potato_s_t.titanium_alloy_sword": "Titanium Alloy Sword",
  "item.potato_s_t.titanium_alloy_pickaxe": "Titanium Alloy Pickaxe",
  "block.potato_s_t.alloy_smelter": "Alloy Smelter Controller",
  "block.potato_s_t.alloy_smelter_port": "Alloy Smelter Port",
  "block.potato_s_t.alloy_smelter_part": "Alloy Smelting Furnace",
  "tooltip.potato_s_t.alloy_smelter": "How to lay out the Alloy Smelter\n1 Heat-Resistant Metal Block  2 Common Metal Block  3 Heater  4 Blast Furnace\n5 Wiring Block  6 Heat Sink  7 Alloy Smelter Controller  0 Empty\nLayer 1 (bottom) | Layer 2\n2222 | 5115\n2332 | 4004\n2332 | 4004\n2332 | 4004\n2222 | 6117\nLayer 3 | Layer 4 (top)\n1111 | 0110\n1001 | 0110\n1001 | 0110\n1001 | 0110\n1111 | 0110\nBuild all 4 layers to the blueprint (58 cells to check: the base, the three-high wall and those two columns of Heat-Resistant Metal Block on the roof) and make sure the shell carries at least 1 Wiring Block; then it activates on its own (the inside is up to you, and the rest of the roof does not matter).\nRight-clicking the controller also activates it, and it will tell you which cell is missing. Only once it is active does right-clicking open the GUI.\n5 input slots that take ingots only, 3 output slots, 2 consumption slots (they take whatever a recipe names as its consumable); 32768 FE of storage, and power comes in through the port alone. Four recipes in JEI;",
  "gui.potato_s_t.alloy_smelter.invalid": "Gap in the shell: layer %s, row %s, column %s is %s (at %s %s %s) - this cell needs a machine block",
  "gui.potato_s_t.alloy_smelter.no_port": "No Wiring Block anywhere on the shell, so no power can get in: the shell needs at least 1",
  "gui.potato_s_t.alloy_smelter.formed": "Alloy Smelting Furnace activated",
  "gui.potato_s_t.alloy_smelter.consume_slot": "Consumption slot (takes the recipe's consumables)",
  "gui.potato_s_t.alloy_smelter.input_hint": "Input slots take ingots only",
  "gui.potato_s_t.alloy_smelter.name": "Alloy Smelting Furnace",
  "gui.potato_s_t.alloy_smelter.status": "Alloy Smelting Furnace active: %s / %s FE",
  "block.potato_s_t.oil_pump": "Oil Extractor",
  "tooltip.potato_s_t.oil_pump": "Only runs in the Ocean Oilfield biome - anywhere else it shuts down.\nThe block below must be water, and waterlogged chains are required (count up to 64 blocks).\nEvery 25-80 buckets pumped, the ocean oilfield in a 10x10 chunk area centred on the machine turns into ordinary ocean (frozen / warm / temperate ...).\n⚠ That area includes the machine itself, so after one pumping session move it to wherever oilfield is left.",
  "gui.potato_s_t.oil_pump.chains": "Waterlogged chains: %s",
  "gui.potato_s_t.oil_pump.rate": "Draw %s FE/t · Output %s mB/s",
  "gui.potato_s_t.oil_pump.status.running": "Pumping oil",
  "gui.potato_s_t.oil_pump.status.disabled": "Stopped (redstone signal)",
  "gui.potato_s_t.oil_pump.status.no_power": "Not enough power: 8n² + 80n FE per tick (n = waterlogged chains below)",
  "gui.potato_s_t.oil_pump.status.output_full": "The 25-bucket tank is full; drain it with pipes or a fluid pump",
  "gui.potato_s_t.oil_pump.status.not_oilfield": "Not in the Ocean Oilfield biome - this machine only runs there",
  "gui.potato_s_t.oil_pump.status.no_chain": "No waterlogged chains below: hang chains straight down from the machine, under water",
  "block.potato_s_t.lithium_battery_plant": "Lithium Battery Plant",
  "tooltip.potato_s_t.lithium_battery_plant": "【Four inputs】: raw manganese/raw aluminum · nickel ingot/raw nickel · lithium carbonate · cobalt ingot/raw cobalt.\nFeed in sulfuric acid, and 30 seconds later one Lithium Battery Component comes out\n⚠ This machine uses no power at all - it is chemistry, not electricity. A redstone signal stops it (progress is kept).",
  "item.potato_s_t.lithium_battery_component": "Lithium Battery Component",
  "gui.potato_s_t.lithium_battery_plant.status.running": "Building a lithium battery",
  "gui.potato_s_t.lithium_battery_plant.status.disabled": "Stopped (redstone signal)",
  "gui.potato_s_t.lithium_battery_plant.status.no_acid": "Not enough sulfuric acid: 1 mB per tick",
  "gui.potato_s_t.lithium_battery_plant.status.inputs": "Missing inputs: raw manganese/raw aluminum, nickel/raw nickel, lithium carbonate, cobalt/raw cobalt",
  "gui.potato_s_t.lithium_battery_plant.status.output_full": "The output slot is full",
  "gui.potato_s_t.lithium_battery_plant.status.empty": "Idle",
  "advancements.potato_s_t.new_beginning.title": "PotatoS&T",
  "advancements.potato_s_t.new_beginning.description": "Build the Micro Crusher - it grinds ore into dust, and everything else stands on it",
  "advancements.potato_s_t.stronger_power.title": "A Stronger Power Source",
  "advancements.potato_s_t.stronger_power.description": "Electricity makes magnetism, magnetism makes electricity... do not ask why a wire carries power, just enjoy it",
  "advancements.potato_s_t.clean_energy.title": "Clean Energy 101",
  "advancements.potato_s_t.clean_energy.description": "Daylight only, strongest at noon; a thunderstorm hater",
  "block.potato_s_t.hydrodesulfurization_chamber": "Hydrodesulfurization Chamber",
  "item.potato_s_t.sulfur": "Sulfur",
  "tooltip.potato_s_t.hydrodesulfurization_chamber": "A redstone signal halts it (progress kept)\n⚠ This machine draws no power at all - it runs on chemistry, not on your electricity bill",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.running": "Hydrodesulfurizing",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.disabled": "Halted (redstone signal)",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.empty": "Bitumen slot is empty",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.material": "Not enough bitumen: 16 per batch",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.output_full": "Output slot is full, waiting for space",
  "gui.potato_s_t.hydrodesulfurization_chamber.status.no_hydrogen": "Not enough hydrogen: 1000 mB per batch (right-click the machine with a hydrogen tank to pour it in)",
  "gui.potato_s_t.hydrodesulfurization_chamber.pour.empty": "That container is empty",
  "gui.potato_s_t.hydrodesulfurization_chamber.pour.rejected": "Cannot pour in: %s (hydrogen only; it may also be a full tank / the wrong fluid)",
  "gui.potato_s_t.jei.no_energy": "No power needed",
  "fluid_type.potato_s_t.nitrogen": "Nitrogen",
  "fluid_type.potato_s_t.ammonia": "Ammonia",
  "block.potato_s_t.air_separator": "Air Separator",
  "block.potato_s_t.ammonia_synthesis_chamber": "Ammonia Synthesis Chamber",
  "tooltip.potato_s_t.air_separator": "A cheaper source of oxygen (allegedly awa) - the raw material is air, and there is no shortage of that.\nA redstone signal halts it (progress kept).",
  "tooltip.potato_s_t.ammonia_synthesis_chamber": "The catalyst slot takes Iron Dust.\nThe gas tank slots under the input tanks push nitrogen and hydrogen into the machine at 50 mB/t.\nThe gas tank slot under the output tank runs the other way: 50 mB/t, putting ammonia into a tank.\nPumps can only bring nitrogen and hydrogen in, and take ammonia out. A redstone signal halts it.",
  "gui.potato_s_t.air_separator.status.running": "Separating air",
  "gui.potato_s_t.air_separator.status.disabled": "Halted (redstone signal)",
  "gui.potato_s_t.air_separator.status.no_power": "Not enough power: 200 FE per tick",
  "gui.potato_s_t.air_separator.status.output_full": "A tank is full (this batch of nitrogen or oxygen will not fit), waiting for a pump",
  "gui.potato_s_t.ammonia_synthesis.status.running": "Synthesising ammonia",
  "gui.potato_s_t.ammonia_synthesis.status.disabled": "Halted (redstone signal)",
  "gui.potato_s_t.ammonia_synthesis.status.no_power": "Not enough power: 200 FE per tick",
  "gui.potato_s_t.ammonia_synthesis.status.output_full": "Ammonia tank is full, waiting for a pump or a fresh tank",
  "gui.potato_s_t.ammonia_synthesis.status.no_hydrogen": "Not enough hydrogen (input tank is empty: hook up a pump or top it up from a gas tank)",
  "gui.potato_s_t.ammonia_synthesis.status.no_nitrogen": "Not enough nitrogen (input tank is empty: hook up a pump or top it up from a gas tank)",
  "gui.potato_s_t.ammonia_synthesis.status.no_catalyst": "The catalyst slot needs Iron Dust (not consumed)",
  "gui.potato_s_t.ammonia_synthesis.catalyst": "Catalyst (Iron Dust)",
  "gui.potato_s_t.jei.catalyst": "Needs Iron Dust as a catalyst (not consumed)",
  "block.potato_s_t.combustion_chamber": "Combustion Chamber",
  "tooltip.potato_s_t.combustion_chamber": "The fuel slot takes anything a vanilla furnace burns (Lava Bucket 10 s, Diesel / Gasoline Bucket 30 s, everything else 3 s).\nOne batch of fuel + 10 mB Oxygen starts the reaction; while it runs it feeds 800 power per tick to the Power Capturer (diesel 1200 / gasoline 1000)\nLogs -> 10 mB Carbon Dioxide + 1 Charcoal; Diesel / Gasoline Buckets -> 200 mB Carbon Dioxide + 50 mB Water; anything else -> 5 mB Carbon Dioxide.\nThe oxygen tank is input-only (pipe in, or right-click with a gas tank); the carbon dioxide and water tanks are output-only (pump them out). A redstone signal halts it.",
  "gui.potato_s_t.combustion_chamber.status.running": "Reacting",
  "gui.potato_s_t.combustion_chamber.status.disabled": "Halted (redstone signal)",
  "gui.potato_s_t.combustion_chamber.status.empty": "Fuel slot is empty",
  "gui.potato_s_t.combustion_chamber.status.invalid": "This item will not burn (vanilla furnace fuels only)",
  "gui.potato_s_t.combustion_chamber.status.output_full": "The carbon dioxide or water tank is full, pump it out",
  "gui.potato_s_t.combustion_chamber.status.no_oxygen": "Not enough oxygen: 10 mB per reaction",
  "gui.potato_s_t.combustion_chamber.status.byproduct": "The byproduct slot is full (clear room for charcoal / empty buckets)",
  "gui.potato_s_t.combustion_chamber.pour.empty": "That container is empty",
  "gui.potato_s_t.combustion_chamber.pour.rejected": "Cannot pour in: the oxygen tank takes oxygen only (it currently holds %s)",
  "fluid_type.potato_s_t.carbon_dioxide": "Carbon Dioxide",
  "block.potato_s_t.acidic_reaction_chamber": "Acidic Reaction Chamber",
  "tooltip.potato_s_t.acidic_reaction_chamber": "Draws 500 FE/t\nFriendly advice: whatever comes out of here, do not drink it.",
  "gui.potato_s_t.acidic_reaction_chamber.status.running": "Reacting",
  "gui.potato_s_t.acidic_reaction_chamber.status.disabled": "Halted (redstone signal)",
  "gui.potato_s_t.acidic_reaction_chamber.status.no_power": "Not enough power: 500 FE per tick",
  "gui.potato_s_t.acidic_reaction_chamber.status.output_full": "The product tanks are full, pump them out",
  "gui.potato_s_t.acidic_reaction_chamber.status.material": "Not enough sulfur for the reaction (10 needed)",
  "gui.potato_s_t.acidic_reaction_chamber.status.inputs": "Not enough fluid input (an input tank this recipe needs is empty: hook up a pump or use a gas tank)",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.name.0": "Carbonic Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.name.1": "Nitric Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.name.2": "Sulfuric Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.info.0": "Carbonic Acid: 10 mB Carbon Dioxide + 1 mB Water per tick -> 1 mB Carbonic Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.info.1": "Nitric Acid: 1 mB Oxygen + 1 mB Ammonia per tick -> 1 mB Nitric Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.info.2": "Sulfuric Acid: one batch of 10 Sulfur + 100 mB Water -> 100 mB Sulfuric Acid (5 seconds)",
  "fluid_type.potato_s_t.carbonic_acid": "Carbonic Acid",
  "fluid_type.potato_s_t.nitric_acid": "Nitric Acid",
  "fluid_type.potato_s_t.sulfuric_acid": "Sulfuric Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.name.3": "Hydrochloric Acid",
  "gui.potato_s_t.acidic_reaction_chamber.recipe.info.3": "Hydrochloric Acid: 10 mB Hydrogen + 10 mB Chlorine + 5 mB Water per tick -> 5 mB Hydrochloric Acid",
  "fluid_type.potato_s_t.hydrochloric_acid": "Hydrochloric Acid",
  "item.potato_s_t.star_steel_ingot": "Star Steel Ingot",
  "item.potato_s_t.star_steel_axe": "Star Steel Axe",
  "item.potato_s_t.star_steel_sword": "Star Steel Sword",
  "item.potato_s_t.star_steel_pickaxe": "Star Steel Pickaxe",
  "item.potato_s_t.star_steel_hoe": "Star Steel Hoe",
  "item.potato_s_t.star_steel_shovel": "Star Steel Shovel",
  "tooltip.potato_s_t.star_steel_axe.1": "No durability loss at night; Haste I while held. 1192 durability, diamond mining level",
  "tooltip.potato_s_t.star_steel_axe.2": "Shift + right-click: spend 120 durability to send a 6-block-wide shockwave along your facing",
  "tooltip.potato_s_t.star_steel_axe.3": "The shockwave fells every log along its path; it dies when it meets a block the axe cannot mine, or after 10 s without touching wood.\nIn the End it also deals ranged damage",
  "tooltip.potato_s_t.star_steel_tool.1": "No durability loss from mining or attacking at night. 1192 durability, diamond mining level",
  "tooltip.potato_s_t.star_steel_sword.1": "No durability loss from mining or attacking at night. 1192 durability, diamond mining level",
  "tooltip.potato_s_t.star_steel_sword.2": "Shift + right-click: spend 100 durability to cut an 8-block starlight slash along your facing",
  "tooltip.potato_s_t.star_steel_sword.3": "The slash pierces every enemy along its path for 12 damage and lights them up for 5 s",
  "tooltip.potato_s_t.vibranium_sword.1": "Unbreakable. 24 attack damage, 1.4 attacks per second, and it scarcely answers the enchanting table (enchantment weight 1)",
  "tooltip.potato_s_t.vibranium_sword.2": "While held: immunity to Wither, Slowness and Mining Fatigue - none of the three can touch you",
  "tooltip.potato_s_t.vibranium_sword.3": "Shift + right-click to slam the ground: every creature within 6x6 (except you) is launched, takes your base damage + 12, and is blinded and slowed for 4 s. 6 s cooldown",
  "item.potato_s_t.titanium_alloy_helmet": "Titanium Alloy Helmet",
  "item.potato_s_t.titanium_alloy_chestplate": "Titanium Alloy Chestplate",
  "item.potato_s_t.titanium_alloy_leggings": "Titanium Alloy Leggings",
  "item.potato_s_t.titanium_alloy_boots": "Titanium Alloy Boots",
  "item.potato_s_t.star_steel_helmet": "Star Steel Helmet",
  "item.potato_s_t.star_steel_chestplate": "Star Steel Chestplate",
  "item.potato_s_t.star_steel_leggings": "Star Steel Leggings",
  "item.potato_s_t.star_steel_boots": "Star Steel Boots",
  "item.potato_s_t.vibranium_helmet": "Vibranium Helmet",
  "item.potato_s_t.vibranium_chestplate": "Vibranium Chestplate",
  "item.potato_s_t.vibranium_leggings": "Vibranium Leggings",
  "item.potato_s_t.vibranium_boots": "Vibranium Boots",
  "death.attack.potato_s_t.vibranium_reflect": "%1$s had their own blow returned, exactly as it came",
  "death.attack.potato_s_t.star_steel_slash": "%1$s was pierced by starlight",
  "tooltip.potato_s_t.vibranium_set": "Vibranium set: a body that does not yield.\nUnbreakable, and it scarcely answers the enchanting table (enchantment weight 2, the lowest in the game) - it needs no adornment.\nWith all four: Resistance I at all times, in any hour and any dimension; immunity to fall damage; projectiles do nothing, and what flies at you returns along its own path at half speed; explosions are halved; knockback does not exist.\nAnd for every blow taken, there is a 10% chance it is given back exactly as it came - the body never takes; it only returns.",
  "tooltip.potato_s_t.titanium_alloy_set": "Titanium Alloy set: a balance of temper and enchantment.\nIt answers the enchanting table more readily than gold, and endures more besides.",
  "tooltip.potato_s_t.star_steel_set": "Star Steel set: in tune with the night.\nWhen darkness falls, every piece grants Resistance I, and the gear does not wear. The power of Star Steel goes further than that - the helmet opens a sight beyond sight. That is Night Vision III: 13 s at a time, renewed while worn, never flickering.\nAll four in resonance reveal its true form: no wear in the End.\nThe void cannot take you either - it finds you solid ground within 20x20, catching you first and erasing the fall; where nothing stands, it trades your place with a creature nearby.",
  "message.potato_s_t.star_steel_void_block": "Star Steel set: teleported onto the nearest block",
  "message.potato_s_t.star_steel_void_swap": "Star Steel set: no block nearby, swapped places with a mob",
  "message.potato_s_t.star_steel_void_failed": "Star Steel set: no block and no mob to swap with",
  "item.potato_s_t.hard_titanium_alloy": "Hard Titanium Alloy",
  "advancements.potato_s_t.acid.description": "The strong backbone of the chemical industry - and by the way, when do we get carbonated drinks?",
  "advancements.potato_s_t.acid.title": "Acidic Reaction Chamber",
  "advancements.potato_s_t.alloy_smelter.description": "Where the alloys begin",
  "advancements.potato_s_t.alloy_smelter.title": "Stoke the Alloy Line",
  "advancements.potato_s_t.ammonia.description": "The Air Separator gives nitrogen; nitrogen + hydrogen become ammonia in the Synthesis Chamber (the raw material for nitric acid)",
  "advancements.potato_s_t.ammonia.title": "Synthesising Ammonia",
  "advancements.potato_s_t.blast_furnace.description": "A 3×3×3 multiblock machine, and a step up in output",
  "advancements.potato_s_t.blast_furnace.title": "Raise a Blast Furnace",
  "advancements.potato_s_t.capacitor.description": "This is a supercapacitor!",
  "advancements.potato_s_t.capacitor.title": "Faraday's Might",
  "advancements.potato_s_t.combustion.description": "A charcoal enthusiast",
  "advancements.potato_s_t.combustion.title": "Combustion Chamber",
  "advancements.potato_s_t.crushing.description": "Can a crusher crush a crusher that is crushing a crusher?",
  "advancements.potato_s_t.crushing.title": "Ground to Dust",
  "advancements.potato_s_t.distillation.description": "By the power of physics, split crude oil into diesel, gasoline, naphtha....",
  "advancements.potato_s_t.distillation.title": "Five Equal Parts of Crude Oil",
  "advancements.potato_s_t.electrolyzer.description": "In reality, this is a real power hog!",
  "advancements.potato_s_t.electrolyzer.title": "Split the Water",
  "advancements.potato_s_t.first_power.description": "Industrial revolution!!",
  "advancements.potato_s_t.first_power.title": "First Kilowatt",
  "advancements.potato_s_t.fuel.description": "Two liquid fuels, stubborn the elder, and the younger just as stubborn",
  "advancements.potato_s_t.fuel.title": "Diesel and Gasoline",
  "advancements.potato_s_t.gas_handling.description": "Gas tanks take gases, oil buckets take liquids; the Filling Machine fills both",
  "advancements.potato_s_t.gas_handling.title": "Handling Gases",
  "advancements.potato_s_t.hard_alloy.description": "This stuff is actually aerospace material",
  "advancements.potato_s_t.hard_alloy.title": "Hard Titanium Alloy",
  "advancements.potato_s_t.light_alloy.description": "A gear revolution",
  "advancements.potato_s_t.light_alloy.title": "Light Titanium Alloy",
  "advancements.potato_s_t.music_disc_anvil.description": "The Republic shows no mercy to those who only know how to work the anvil",
  "advancements.potato_s_t.music_disc_anvil.title": "Anvil of the Republic (or should that be Chastity?)",
  "advancements.potato_s_t.music_disc_jasmine.description": "What a beautiful jasmine flower~",
  "advancements.potato_s_t.music_disc_jasmine.title": "Jasmine Flower",
  "advancements.potato_s_t.oil.description": "Take an empty bucket to a surface oilfield and scoop up crude oil (an empty bucket does not count)",
  "advancements.potato_s_t.oil.title": "Oil",
  "advancements.potato_s_t.pressing.description": "The hydraulic press turns ingots into plates - the common part of nearly every machine",
  "advancements.potato_s_t.pressing.title": "Pressed into Plates",
  "advancements.potato_s_t.stable_block.description": "The Acidic Reaction Chamber wants it",
  "advancements.potato_s_t.stable_block.title": "Stable Metal Block",
  "advancements.potato_s_t.steel.description": "Steel is the skeleton of nearly everything that comes after",
  "advancements.potato_s_t.steel.title": "Thus Is Steel Tempered",
  "advancements.potato_s_t.sulfur.description": "Bitumen + hydrogen into the Hydrodesulfurization Chamber -> Sulfur (the raw material for sulfuric acid)",
  "advancements.potato_s_t.sulfur.title": "Sulfur Out of Bitumen",
  "advancements.potato_s_t.titanium.description": "Crush raw titanium into dust first, then smelt that dust in the Electric Blast Furnace",
  "advancements.potato_s_t.titanium.title": "Titanium",
  "advancements.potato_s_t.titanium_tools.description": "Light Titanium Alloy + sticks -> Titanium Alloy sword and pickaxe",
  "advancements.potato_s_t.titanium_tools.title": "Titanium Alloy Tools",
  "advancements.potato_s_t.wiring.description": "Remote transmission!",
  "advancements.potato_s_t.wiring.title": "Wired Up",
  "advancements.potato_s_t.fluid_logistics.description": "Does this thing spray chocolate syrup?",
  "advancements.potato_s_t.fluid_logistics.title": "Fluid Logistics",
  "advancements.potato_s_t.lithium_battery.description": "Quantity turns into quality",

{
  "multipart": [
    { "apply": { "model": "potato_s_t:block/fluid_pipe_core" } },
    { "when": { "north": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm", "x": 90 } },
    { "when": { "east": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm", "x": 90, "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm", "x": 90, "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm", "x": 90, "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm" } },
    { "when": { "down": "true" }, "apply": { "model": "potato_s_t:block/fluid_pipe_arm", "x": 180 } }
  ]
}